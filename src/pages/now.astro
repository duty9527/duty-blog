---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ABOUT_PARAGRAPHS, VANBLOG_STATS, formatDateCN } from '../consts';

const aboutUpdatedDate = formatDateCN(new Date(VANBLOG_STATS.aboutUpdatedAt));
---

<BaseLayout title="关于 / Now" description="关于我 (/about & /now)">
  <div class="cmd-label">$ uptime && cat ./about.md</div>
  <h1 style="font-size: 1.25rem; margin: 0 0 0.5rem;">~/about — 关于我</h1>
  <p style="font-size: 0.78rem; color: var(--muted); margin: 0 0 1.75rem;">
    Last updated: {aboutUpdatedDate}
  </p>

  <div class="prose">
    {ABOUT_PARAGRAPHS.map((p) => <p>{p}</p>)}
  </div>
</BaseLayout>

