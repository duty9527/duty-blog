---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  ABOUT_PARAGRAPHS,
  AUTHOR_NAME,
  AUTHOR_DESC,
  AUTHOR_LOGO,
  CATEGORIES,
  formatDateCN,
} from '../consts';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentPosts = allPosts.slice(0, 10);

const categoryCounts = new Map<string, number>();
CATEGORIES.forEach((c) => categoryCounts.set(c, 0));
allPosts.forEach((post) => {
  const cat = post.data.category || '随笔';
  categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
});

const essayPosts = allPosts
  .filter((p) => p.data.category === '随笔')
  .slice(0, 4);
---

<BaseLayout>
  <!-- Bio Section -->
  <section style="margin-bottom: 2.5rem;">
    <div class="cmd-label">$ whoami && cat about.txt</div>
    <div class="panel" style="display: flex; flex-direction: column; gap: 0.7rem;">
      <div style="display: flex; align-items: center; gap: 0.85rem;">
        <img
          src={AUTHOR_LOGO}
          alt={AUTHOR_NAME}
          width="44"
          height="44"
          style="border-radius: 50%; object-fit: cover; border: 1px solid var(--border);"
        />
        <div>
          <div style="font-weight: 700; font-size: 0.95rem;">
            {AUTHOR_NAME}{' '}
            <span style="font-weight: 400; font-size: 0.8rem; color: var(--accent);">
              ({AUTHOR_DESC})
            </span>
          </div>
          <div style="font-size: 0.76rem; color: var(--muted);">
            Life Is Knowledge · “Be Patient With Yourself. You're Working On It.”
          </div>
        </div>
      </div>
      <p style="margin: 0; font-size: 0.88rem; color: var(--fg);">
        {ABOUT_PARAGRAPHS[0]}
      </p>
    </div>
  </section>

  <!-- Categories Bar -->
  <section style="margin-bottom: 2.5rem;">
    <div class="section-bar">
      <h2>$ ls ./categories</h2>
      <a href="/posts" class="more-link">查看全部分类与标签 →</a>
    </div>
    <div class="tag-bar" style="margin-bottom: 0;">
      {
        Array.from(categoryCounts.entries()).map(([cat, count]) => (
          <a href={`/posts?category=${encodeURIComponent(cat)}`} class="tag-pill">
            [{cat}] ({count})
          </a>
        ))
      }
    </div>
  </section>

  <!-- Recent Posts -->
  <section style="margin-bottom: 2.75rem;">
    <div class="section-bar">
      <h2>$ ls -lt ./posts | head -n 10</h2>
      <a href="/posts" class="more-link">全部文章 ({allPosts.length}) →</a>
    </div>

    <ul class="post-list">
      {
        recentPosts.map((post) => (
          <li class="post-row">
            <div class="post-row-left">
              <span class="post-date">{formatDateCN(post.data.pubDate)}</span>
              <span
                style="font-size: 0.74rem; color: var(--accent); flex-shrink: 0;"
                title="分类"
              >
                [{post.data.category}]
              </span>
              <a href={`/posts/${post.id}`} class="post-title">
                {post.data.title}
              </a>
            </div>
            {post.data.tags.length > 0 && (
              <span class="post-tags">
                {post.data.tags.map((t) => `#${t}`).join(' ')}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Recent Essays (随笔) -->
  <section>
    <div class="section-bar">
      <h2>$ tail -n 4 ./随笔.log</h2>
      <a href="/notes" class="more-link">全部随笔 →</a>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      {
        essayPosts.map((post) => (
          <div class="panel">
            <div style="display: flex; justify-content: space-between; font-size: 0.76rem; color: var(--muted); margin-bottom: 0.35rem;">
              <span>[{formatDateCN(post.data.pubDate)}]</span>
              <span>
                {post.data.tags.map((t) => `#${t}`).join(' ') || '#随笔'}
              </span>
            </div>
            <div style="font-weight: 600; margin-bottom: 0.25rem;">
              <a href={`/posts/${post.id}`}>{post.data.title}</a>
            </div>
            <div style="font-size: 0.85rem; color: var(--muted);">
              {post.data.description}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

