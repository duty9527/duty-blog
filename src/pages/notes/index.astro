---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDateCN } from '../../consts';

const rawEssays = (
  await getCollection('blog', ({ data }) => !data.draft && data.category === '随笔')
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const essays = await Promise.all(
  rawEssays.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  })
);
---

<BaseLayout title="随笔" description="日常生活随录与思考随笔">
  <div class="cmd-label">$ cat ./posts/随笔/*.md</div>
  <h1 style="font-size: 1.25rem; margin: 0 0 0.4rem;">随笔 (Essays & Notes)</h1>
  <p style="font-size: 0.82rem; color: var(--muted); margin: 0 0 2rem;">
    记录生活与日常感悟 —— Life Is Knowledge。
  </p>

  <div class="notes-stream">
    {
      essays.map(({ post, Content }) => (
        <article>
          <div class="note-meta">
            <span>{formatDateCN(post.data.pubDate)}</span>
            <span> · </span>
            <a
              href={`/posts/${post.id}`}
              style="font-weight: 700; color: var(--fg); text-decoration: underline;"
            >
              {post.data.title}
            </a>
            {post.data.tags.length > 0 && (
              <span style="color: var(--muted); margin-left: 0.5rem;">
                {post.data.tags.map((t) => `#${t}`).join(' ')}
              </span>
            )}
          </div>
          <div class="prose note-body" style="font-size: 0.9rem;">
            <Content />
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>

