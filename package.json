{
  "name": "duty-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Minimalist monospace personal blog built with Astro and deployed on Cloudflare Pages",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync:notes": "node scripts/sync-apple.mjs --notes",
    "install:daemon": "node scripts/sync-apple.mjs --install-daemon",
    "uninstall:daemon": "node scripts/sync-apple.mjs --uninstall-daemon",
    "import:journal": "node scripts/sync-apple.mjs --journal"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "astro": "^5.5.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
